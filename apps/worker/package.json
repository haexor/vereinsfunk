{
  "name": "@vereinsfunk/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.28.0",
    "@vereinsfunk/contracts": "workspace:*",
    "@vereinsfunk/domain": "workspace:*",
    "@vereinsfunk/media-processing": "workspace:*",
    "@vereinsfunk/observability": "workspace:*",
    "@vereinsfunk/orchestration": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
