{
  "name": "@vereinsfunk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts --out-dir dist",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.0",
    "@supabase/supabase-js": "^2.55.0",
    "@vereinsfunk/authorization": "workspace:*",
    "@vereinsfunk/config": "workspace:*",
    "@vereinsfunk/content-engine": "workspace:*",
    "@vereinsfunk/contracts": "workspace:*",
    "@vereinsfunk/domain": "workspace:*",
    "@vereinsfunk/observability": "workspace:*",
    "@vereinsfunk/orchestration": "workspace:*",
    "@vereinsfunk/secrets": "workspace:*",
    "@vereinsfunk/svg-safe": "workspace:*",
    "fastify": "^5.11.0",
    "jose": "^6.1.0",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
