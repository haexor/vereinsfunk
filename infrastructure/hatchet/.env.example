# Copy to .env. Keep it out of source control and rotate these credentials according to
# docs/operations/hatchet.md. Not production-ready as-is: every secret placeholder below
# (passwords, cookie secrets) must be replaced with a freshly generated, unique value per
# environment.
HATCHET_POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode the password when constructing this value.
HATCHET_DATABASE_URL=postgresql://hatchet:replace-with-a-long-random-password@hatchet-postgres:5432/hatchet?sslmode=disable
# Stable, reachable per-environment values, not randomly generated.
HATCHET_PUBLIC_URL=https://hatchet.example.invalid
HATCHET_COOKIE_DOMAIN=hatchet.example.invalid
# The address workers use from outside this compose network. Stable per-environment value,
# not randomly generated.
HATCHET_GRPC_BROADCAST_ADDRESS=hatchet.example.invalid:7077
# Two rotating AES cookie keys (each 16, 24 or 32 bytes), space-separated. Generate your own,
# e.g. with: echo "$(openssl rand -hex 16) $(openssl rand -hex 16)"
HATCHET_COOKIE_SECRETS=replace-with-two-generated-aes-keys-space-separated
