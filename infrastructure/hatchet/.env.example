# Copy to .env. Keep it out of source control and rotate these credentials according to
# docs/operations/hatchet.md once that runbook is added.
HATCHET_POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode the password when constructing this value.
HATCHET_DATABASE_URL=postgresql://hatchet:replace-with-a-long-random-password@hatchet-postgres:5432/hatchet?sslmode=disable
HATCHET_PUBLIC_URL=https://hatchet.example.invalid
HATCHET_COOKIE_DOMAIN=hatchet.example.invalid
# The address workers use from outside this compose network.
HATCHET_GRPC_BROADCAST_ADDRESS=hatchet.example.invalid:7077
# Two rotating AES cookie keys (each 16, 24 or 32 bytes), space-separated.
HATCHET_COOKIE_SECRETS="replace-with-32-byte-cookie-secret-01 replace-with-32-byte-cookie-secret-02"
