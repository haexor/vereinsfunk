{
  "name": "marketing-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:web": "pnpm --filter @vereinsfunk/web dev",
    "dev:api": "pnpm --filter @vereinsfunk/api dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "pnpm db:test:isolation && supabase test db",
    "db:test:isolation": "node scripts/check-pgtap-isolation.mjs",
    "lint": "eslint .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "supabase": "2.111.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.38.0",
    "vue-eslint-parser": "^10.4.1",
    "vitest": "^4.1.10"
  }
}
