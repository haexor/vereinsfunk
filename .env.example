# Server-side values for api and worker. Browser-safe NUXT_PUBLIC_* values live in
# apps/web/.env.example -- Nuxt loads .env from its own rootDir, and keeping the two apart
# means the web process never holds the service role key.

# API-only values
API_HOST=0.0.0.0
API_PORT=4201
LOG_LEVEL=info
SUPABASE_URL=http://127.0.0.1:4260
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Direct Postgres connection (not the PostgREST URL above) for the migration boot hook
# (packages/db-migrate, Plan 036). `supabase status` prints the local value; a linked remote
# project needs its "Session pooler" connection string (port 5432), not "Transaction pooler"
# (6543, unsuitable for DDL) -- see plans/036-migrationen-beim-container-start-automatisieren.md.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:4261/postgres
# Optional HS256 override -- leave empty. The local stack signs real tokens with ES256 (JWKS), so
# setting this rejects every one of them with an algorithm mismatch (401 on every authenticated
# route). Only needed for self-signed test tokens or a project intentionally kept on the legacy
# shared secret; apps/api/src/auth.ts falls back to JWKS against SUPABASE_URL when unset.
SUPABASE_JWT_SECRET=
# Base URL of the Nuxt frontend. The API puts it into invitation links and accepts exactly this
# origin for CORS -- a web dev server on a different port needs this set, or every browser call
# fails the preflight. Falls back to http://localhost:4200 when unset; required in production.
WEB_BASE_URL=http://localhost:4200
# Bootstraps exactly one default platform admin on server start. The account must already exist
# in auth.users (register first, then set this), otherwise the RPC aborts. Empty means no
# bootstrap wanted yet.
PLATFORM_ADMIN_DEFAULT_EMAIL=

# SMTP for domain emails such as consent requests. Account invitations use Supabase Auth's
# configured provider (for example Brevo), so they do not need SMTP credentials here. 'fake'
# only writes such domain emails to the API log; production must use smtp.
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Encrypts stored LLM provider API keys (AES-256-GCM). A JSON map of key version to a base64
# key that must decode to exactly 32 bytes; SECRET_BOX_CURRENT_KEY_VERSION has to name one of
# its entries. The all-zero key below is a throwaway for local development -- generate a real
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_BOX_KEYS={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
SECRET_BOX_CURRENT_KEY_VERSION=v1

# Pepper for hashing IP/user-agent on a digital consent response (Paket 015). Falls back to a
# fixed local-dev value when unset -- required in production, startup fails without it.
CONSENT_RESPONSE_HASH_PEPPER=

# Optional provider adapters
HATCHET_CLIENT_TOKEN=
# Hatchet's private control-plane API, only used by API/worker processes.
HATCHET_CLIENT_API_URL=http://localhost:8080
# gRPC endpoint of the self-hosted Hatchet engine. In production use its internal DNS
# name; the public Hatchet dashboard/API must not be exposed to the browser.
HATCHET_CLIENT_HOST_PORT=localhost:7077
HATCHET_TLS=true
OPENAI_API_KEY=
REMOTION_FUNCTION_NAME=
# Social publishing. Comma-separated set of providers to run for real, e.g.
# `meta,twitter,linkedin`. A single value such as `meta` remains valid. The
# adapter mode is separate: `disabled` is the safe production baseline, `fake`
# is explicitly non-production and never
# turns a selected live provider into a fake one. Client ID/secret are never
# deployment configuration -- a platform admin enters them under Plattform-
# Administration -> Einstellungen -> Social-Media-Provider, where the API
# stores them encrypted (SECRET_BOX_KEYS) in Supabase. For `meta`,
# META_OAUTH_REDIRECT_URL and API_PUBLIC_BASE_URL are still required
# deployment configuration (analogous TWITTER_*/LINKEDIN_* redirect URLs for
# those providers). META_GRAPH_VERSION defaults to v21.0.
PUBLISHING_PROVIDER=meta,twitter,linkedin
PUBLISHING_MODE=disabled
# Set this explicitly to a Meta Graph API version that Meta currently supports.
META_GRAPH_VERSION=v21.0
# Public API base URL. The API derives separate callbacks for Instagram and
# Facebook below this URL; register both exact callback URLs in the Meta app.
META_OAUTH_REDIRECT_URL=
# Public API base URL; the API derives the /v1/channels/connect/twitter/callback
# URL below this. Register the exact callback URL in the X app.
TWITTER_OAUTH_REDIRECT_URL=
# Public API base URL; the API derives the /v1/channels/connect/linkedin/callback
# URL below this. Register the exact callback URL in the LinkedIn app.
LINKEDIN_OAUTH_REDIRECT_URL=
# Public API base URL used by Meta/X/LinkedIn to retrieve short-lived,
# media-specific grants while publishing. This must not point at the Nuxt frontend.
API_PUBLIC_BASE_URL=
